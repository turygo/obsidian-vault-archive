{
	"name": "obsidian-vault-archive",
	"version": "1.1.0",
	"description": "Archive notes with configurable path and frontmatter rules.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "node --experimental-strip-types --test test/*.test.mjs",
		"install:local": "node scripts/install-local.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"engines": {
		"node": ">=22.6"
	},
	"keywords": ["obsidian", "archive"],
	"author": "turygo",
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.55.0"
	},
	"overrides": {
		"@typescript-eslint/visitor-keys": "8.55.0"
	}
}
